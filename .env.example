# Tide Line environment template.
# Copy to .env.local and fill in DEV values only. Do not commit real keys.
# The mobile app may use only the public Supabase anon key.
# Never put SUPABASE_SERVICE_ROLE_KEY in Expo or any client bundle.

# DEV Supabase project
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here

# Project refs, for humans and the Supabase CLI. Not read by the app.
SUPABASE_DEV_PROJECT_REF=your_dev_project_ref
SUPABASE_PRODUCTION_PROJECT_REF=your_production_project_ref
